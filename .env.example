# Binance API Configuration
# Copy this file to .env and fill in your credentials

# Binance API Key (required)
BINANCE_API_KEY=your_api_key_here

# Binance API Secret (required)
BINANCE_API_SECRET=your_api_secret_here

# Optional: Exchange selection
# Defaults to binance.com-futures for production
# Use binance.com-futures-testnet for testnet
# BINANCE_EXCHANGE=binance.com-futures
